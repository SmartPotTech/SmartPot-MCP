# URL de SmartPot-API (la del stack nuevo, en Go).
SMARTPOT_API_URL=http://localhost:8091

# Solo para stdio: el token de conexión de la persona (spt_…), creado en la PWA en Perfil › Conexiones.
# En HTTP no se usa: cada cliente envía el suyo en la cabecera Authorization.
# SMARTPOT_API_TOKEN=spt_...

# Transporte: "stdio" (cliente local) o "streamable-http" (contenedor).
TRANSPORT=stdio

# Red del transporte HTTP.
HOST=127.0.0.1
PORT=8002
MCP_PATH=/mcp

# Protección contra DNS rebinding: Host y Origin aceptados (separados por comas).
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://smartpot.app,https://www.smartpot.app

# Máximo de filas que una herramienta trae de una vez.
MCP_MAX_ROWS=500

# Tiempo de espera de las llamadas a la API (segundos) y nivel de registro.
TIMEOUT_SECONDS=15.0
LOG_LEVEL=INFO
