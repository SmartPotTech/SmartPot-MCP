flowchart TB
  subgraph capabilities["FastMCP Capabilities Map (25 Tools · 5 Resources · 3 Prompts)"]
    direction TB
    subgraph read_tools["READ Scope Tools (20 Tools)"]
      t_crops["list_crops · get_crop · get_crop_health<br/>get_crop_environment · list_virtual_crops"]
      t_readings["get_latest_reading · get_readings_history<br/>get_reading_aggregates · get_crop_kpis"]
      t_actuators["list_actuators · get_actuator_state<br/>list_command_history · get_command_status"]
      t_notif["list_notifications · get_unread_count<br/>get_alert_channels · get_system_status"]
    end

    subgraph control_tools["CONTROL Scope Tools (5 Tools)"]
      t_act["trigger_actuator · trigger_actuator_timed<br/>emergency_stop_all · pause_virtual_crop · resume_virtual_crop"]
    end

    subgraph resources["Exposed Resources (5 Resources)"]
      r_state["smartpot://crops/{id}/state<br/>smartpot://crops/{id}/telemetry<br/>smartpot://crops/{id}/actuators<br/>smartpot://system/topology<br/>smartpot://alerts/active"]
    end

    subgraph prompts["Context Prompts (3 Prompts)"]
      p_diag["diagnose_crop_health<br/>investigate_telemetry_anomaly<br/>recommend_actuator_schedule"]
    end
  end

  api["SmartPot-API (Endpoints)"]
  read_tools -->|"GET queries"| api
  control_tools -->|"POST commands"| api
  resources -.->|"Snapshot fetch"| api

  classDef leaf fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef water fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef sun fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef core fill:#067A52,stroke:#0B3D2B,color:#FFFFFF

  class read_tools,resources leaf
  class control_tools sun
  class prompts water
  class api core
